# Copy to .env and edit. Everything is optional.

# Where the app listens. 0.0.0.0 = reachable from other devices on your home network.
PORT=8080
HOST=0.0.0.0

# The local language model server (Ollama stays on this PC: keep it on 127.0.0.1).
OLLAMA_URL=http://127.0.0.1:11434
# Model suggested in the AI settings. Any Ollama model that can follow a JSON schema works.
OLLAMA_MODEL=qwen3:14b
# The picture-reading model for "Recreate from picture" (Qwen3-VL 8B Instruct, about 6 GB; the plain 8b tag is a thinking model and far too slow here; fits a 16 GB card on its own). It takes
# turns with the model above and with ComfyUI on the one GPU queue; docker compose pulls it in the background.
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct

# If set, everyone must type this password once per device (recommended on shared Wi-Fi).
APP_PASSWORD=

# The optional image service (docker compose --profile render up -d). docker-compose.yml sets this for you.
# The AI image service. Default: the ComfyUI in docker-compose.yml (docker compose --profile comfyui up -d, about 27 GB).
# To use a ComfyUI already installed on this PC (started with --listen, port 8188), point the app at it instead:
# COMFYUI_URL=http://host.docker.internal:8188
# Studio render (Blender Cycles): a Blender 4.2 on this PC (running the server without Docker), or the docker service
# (docker compose --profile render up -d sets BLENDER_URL itself).
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# BLENDER_URL=http://blender:9000
