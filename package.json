{
  "name": "duplex-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:viewer",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "prebuild": "npm run build:viewer",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:gpu": "playwright test -c playwright.gpu.config.ts",
    "test:coverage": "VITE_COVERAGE=1 vitest run --coverage",
    "server": "tsx server/index.ts",
    "start": "npm run build && tsx server/index.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "ai:eval:vision": "tsx scripts/ai-eval-vision.ts",
    "assets:download": "tsx scripts/assets-download.ts",
    "assets:licenses": "tsx scripts/assets-licenses.ts",
    "reference:build": "tsx scripts/reference-build.ts",
    "build:server": "esbuild server/index.ts server/cli.ts --bundle --platform=node --format=esm --target=node20 --outdir=server-dist --out-extension:.js=.mjs --external:better-sqlite3 --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "better-sqlite3": "^13.0.3",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "polygon-clipping": "^0.15.7",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.16",
    "workbox-window": "^7.4.1",
    "ws": "8.22.0",
    "xatlas-web": "0.1.0",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "three-mesh-bvh": "0.9.16"
  }
}
